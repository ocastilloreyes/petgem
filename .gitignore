# Build output directory
build/

# Documentation build output. docs/source/api and docs/source/readme are
# regenerated by scripts/auto_doc/prepare_docs.sh, so they are absent from a
# fresh clone.
docs/build/
docs/doxygen/
docs/source/api
docs/source/readme

# Example run artifacts - everything generated lands in <case>/outputs/, which
# scripts/build_bundles.sh creates on demand, so it is absent from a fresh
# clone. Committed inputs (geometry/, survey/, scripts/), configs/ and the
# reference/ goldens stay tracked.
examples/*/outputs/

# Local working directories, kept out of the distribution
data/
gaussian_beam_boundary_excitation/

# Run-time artifacts dropped at the repo root
petgem*.err
petgem*.out

# Python bytecode
**/__pycache__/

# Editor / OS noise
.DS_Store
.vscode/
.idea/
*~

# Object files, executables, libraries
*.o
*.so
*.a
*.dll
*.exe
