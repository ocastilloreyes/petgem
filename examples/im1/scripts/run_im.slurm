#!/bin/bash

# ============================================================================
# CSEM inversion benchmark (im1): inversion
#
# This job runs im.csem, which recovers the conductivity model with L-BFGS
# and an adjoint-state gradient. The case options are read from
# configs/params_im.txt and the solver options from a separate preset.
# The forward and adjoint solves share the same KSP, so the preset applies
# to both.
#
# The linear solver is chosen with the SOLVER variable:
#   bddc   Iterative PCBDDC solver (default)
#   mumps  MUMPS direct solver
#
# Usage:
#   sbatch scripts/run_im.slurm
#   SOLVER=mumps sbatch scripts/run_im.slurm
#
# Required input:
#   outputs/input_im.h5
#     Generated by scripts/build_bundles.sh im
#
# Generated output:
#   outputs/responses_im_p2.h5
#     Recovered conductivity, log_perturbation and rms_history
#   VTU snapshots of the model
#
# To analyse the results (from the repository root):
#   python3 examples/im1/scripts/analyze_inversion.py \
#       -run_dir   examples/im1/outputs \
#       -reference examples/im1/reference/reference_metrics.json
#
# Notes:
#   - Submit this job from examples/im1.
#   - The execution environment is loaded from PETGEM_ENV when defined.
#   - Otherwise, scripts/mn5/set_env.sh is used.
# ============================================================================

#SBATCH --job-name=im_inv
#SBATCH --output=outputs/im_%j.out
#SBATCH --error=outputs/im_%j.err
#SBATCH --nodes=1
#SBATCH --ntasks=112
#SBATCH --cpus-per-task=1
#SBATCH --time=01:59:00

# Adapt these settings to your HPC system.
#SBATCH --account=<ACCOUNT>
#SBATCH --qos=<QUEUE>

set -euo pipefail

ROOT_DIR=../..
SOLVER="${SOLVER:-bddc}"
PARAMS_FILE="configs/params_im.txt"
SOLVER_FILE="configs/solver_${SOLVER}.txt"
EXECUTABLE="${ROOT_DIR}/build/im.csem"

# Ensure the script is launched from the expected location.
if [[ ! -f "${ROOT_DIR}/Makefile" || ! -d configs ]]; then
    echo "ERROR: please submit this job from examples/im1"
    exit 1
fi

# Load the runtime environment.
ENV_FILE="${PETGEM_ENV:-${ROOT_DIR}/scripts/mn5/set_env.sh}"

echo "Loading environment from:  ${ENV_FILE}"

source "${ENV_FILE}"

srun --cpu-bind=core "${EXECUTABLE}" -options_file "${PARAMS_FILE}" \
    -options_file "${SOLVER_FILE}"
