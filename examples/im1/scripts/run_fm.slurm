#!/bin/bash

# ============================================================================
# CSEM inversion benchmark (im1): forward simulations
#
# This job runs fm.csem on the true conductivity model, one array task per
# frequency. Its responses are later turned into the synthetic observations
# that the inversion tries to fit.
#
# The linear solver is chosen with the SOLVER variable:
#   bddc   Iterative PCBDDC solver (default, scales well in memory)
#   mumps  MUMPS direct solver, useful as an exact cross-check when
#          regenerating reference data
#
# Usage:
#   sbatch scripts/run_fm.slurm
#   SOLVER=mumps sbatch scripts/run_fm.slurm
#
# Required input:
#   outputs/input_fm_f<F>.h5
#     Generated by scripts/build_bundles.sh fm
#
# Generated output:
#   outputs/responses_fm_f<F>_p2.h5
#
# Next step:
#   bash examples/im1/scripts/make_observations.sh   (from the repository root)
#
# Notes:
#   - Submit this job from examples/im1.
#   - The execution environment is loaded from PETGEM_ENV when defined.
#   - Otherwise, scripts/mn5/set_env.sh is used.
# ============================================================================

#SBATCH --job-name=im_fwd
#SBATCH --output=outputs/fm_%A_%a.out
#SBATCH --error=outputs/fm_%A_%a.err
#SBATCH --nodes=1
#SBATCH --ntasks=112
#SBATCH --cpus-per-task=1
#SBATCH --time=00:30:00
#SBATCH --array=0-6

# Adapt these settings to your HPC system.
#SBATCH --account=<ACCOUNT>
#SBATCH --qos=<QUEUE>

set -euo pipefail

ROOT_DIR=../..
SOLVER="${SOLVER:-bddc}"
SOLVER_FILE="configs/solver_${SOLVER}.txt"
EXECUTABLE="${ROOT_DIR}/build/fm.csem"

# Each array task solves one frequency.
FREQS=(1 10 50 100 300 800 1500)
FREQ="${FREQS[$SLURM_ARRAY_TASK_ID]}"

# Ensure the script is launched from the expected location.
if [[ ! -f "${ROOT_DIR}/Makefile" || ! -d configs ]]; then
    echo "ERROR: please submit this job from examples/im1"
    exit 1
fi

# Load the runtime environment.
ENV_FILE="${PETGEM_ENV:-${ROOT_DIR}/scripts/mn5/set_env.sh}"

echo
echo "Loading environment from:  ${ENV_FILE}"

source "${ENV_FILE}"

# Only the input and output paths change with the frequency, so they are
# passed here instead of keeping one options file per frequency.
srun --cpu-bind=core "${EXECUTABLE}" \
    -input_filename   "outputs/input_fm_f${FREQ}.h5" \
    -output_dir       "outputs/" \
    -output_filename  "responses_fm_f${FREQ}_p2" \
    -options_file     "${SOLVER_FILE}"

