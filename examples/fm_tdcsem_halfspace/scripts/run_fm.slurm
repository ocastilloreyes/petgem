#!/usr/bin/env bash

# ============================================================================
# Time-domain CSEM half-space model: forward simulation
#
# This job runs the forward simulation using fm.tdcsem and the direct MUMPS
# solver configured in configs/params.txt.
#
# Usage:
#   sbatch scripts/run_fm.slurm [PETSc options]
#
#   Extra arguments are passed to fm.tdcsem after the defaults, e.g.
#   sbatch scripts/run_fm.slurm -input_filename outputs/input_p1.h5 -output_filename responses_p1
#
# Required input:
#   outputs/input_p2.h5
#     Generated by scripts/build_bundles.sh
#
# Generated output:
#   outputs/responses_p2.h5
#
# To validate the results:
#   python3 scripts/postprocess.py
#
# Notes:
#   - Submit this job from examples/fm_tdcsem_halfspace.
#   - The execution environment is loaded from PETGEM_ENV when defined.
#   - Otherwise, scripts/mn5/set_env.sh is used.
# ============================================================================

#SBATCH --job-name=tdhs_fwd
#SBATCH --output=outputs/fm_%j.out
#SBATCH --error=outputs/fm_%j.err
#SBATCH --nodes=1
#SBATCH --ntasks=56
#SBATCH --cpus-per-task=1
#SBATCH --time=00:30:00

# Adapt these settings to your HPC system.
#SBATCH --account=<ACCOUNT>
#SBATCH --qos=<QUEUE>

set -euo pipefail

ROOT_DIR=../..
PARAMS_FILE="configs/params.txt"
EXECUTABLE="${ROOT_DIR}/build/fm.tdcsem"
TAG="p2"

# Ensure the script is launched from the expected location.
if [[ ! -f "${ROOT_DIR}/Makefile" || ! -d configs ]]; then
    echo "ERROR: please submit this job from examples/fm_tdcsem_halfspace"
    exit 1
fi

# Load the runtime environment.
ENV_FILE="${PETGEM_ENV:-${ROOT_DIR}/scripts/mn5/set_env.sh}"

echo
echo "Loading environment from:  ${ENV_FILE}"

source "${ENV_FILE}"

srun --cpu-bind=core "${EXECUTABLE}" -options_file "${PARAMS_FILE}" \
    -input_filename "outputs/input_${TAG}.h5" \
    -output_dir outputs/ -output_filename "responses_${TAG}" "$@"
