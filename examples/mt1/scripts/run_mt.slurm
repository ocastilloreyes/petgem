#!/bin/bash

# ============================================================================
# Trapezoidal hill MT example
#
# This job runs the forward simulation using fm.mt and the direct MUMPS
# solver configured in configs/params.txt.
#
# Usage:
#   sbatch --export=ALL,ORDER=2,NSKIN=4 scripts/run_mt.slurm
#
# Required input:
#   outputs/input_p<ORDER>_n<NSKIN>.h5
#     Generated by scripts/build_bundles.sh
#
# Generated output:
#   outputs/responses_p<ORDER>_n<NSKIN>.h5
#
# To validate the results:
#   python3 scripts/postprocess.py -order <ORDER>
#
# Notes:
#   - Submit this job from examples/mt1.
#   - The execution environment is loaded from PETGEM_ENV when defined.
#   - Otherwise, scripts/mn5/set_env.sh is used.
# ============================================================================

#SBATCH --job-name=mt_fwd
#SBATCH --output=outputs/mt_%j.out
#SBATCH --error=outputs/mt_%j.err
#SBATCH --nodes=1
#SBATCH --ntasks=56
#SBATCH --cpus-per-task=1
#SBATCH --time=01:00:00

# Adapt these settings to your HPC system.
#SBATCH --account=<ACCOUNT>
#SBATCH --qos=<QUEUE>

set -euo pipefail

ROOT_DIR=../..
PARAMS_FILE="configs/params.txt"
EXECUTABLE="${ROOT_DIR}/build/fm.mt"
ORDER="${ORDER:?set ORDER, e.g. sbatch --export=ALL,ORDER=2,NSKIN=4}"
NSKIN="${NSKIN:?set NSKIN, e.g. sbatch --export=ALL,ORDER=2,NSKIN=4}"
TAG="p${ORDER}_n${NSKIN}"

# Ensure the script is launched from the expected location.
if [[ ! -f "${ROOT_DIR}/Makefile" || ! -d configs ]]; then
    echo "ERROR: please submit this job from examples/mt1"
    exit 1
fi

# Load the runtime environment.
ENV_FILE="${PETGEM_ENV:-${ROOT_DIR}/scripts/mn5/set_env.sh}"

echo
echo "Loading environment from:  ${ENV_FILE}"

source "${ENV_FILE}"

srun --cpu-bind=core "${EXECUTABLE}" -options_file "${PARAMS_FILE}" \
    -input_filename "outputs/input_${TAG}.h5" \
    -output_dir outputs/ -output_filename "responses_${TAG}"

echo
