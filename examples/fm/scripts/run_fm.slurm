#!/bin/bash

# ============================================================================
# Marine CSEM benchmark
#
# This job runs the forward simulation using fm.csem and the iterative
# PCBDDC solver configured in configs/params.txt.
#
# Usage:
#   sbatch scripts/run_fm.slurm
#
# Required input:
#   outputs/input.h5
#     Generated by scripts/build_bundles.sh
#
# Generated output:
#   outputs/responses_p1.h5
#
# To validate the results:
#   python3 scripts/postprocess.py
#
# Notes:
#   - Submit this job from examples/fm.
#   - The execution environment is loaded from PETGEM_ENV when defined.
#   - Otherwise, scripts/mn5/set_env.sh is used.
# ============================================================================

#SBATCH --job-name=fm_fwd
#SBATCH --output=outputs/fm_%j.out
#SBATCH --error=outputs/fm_%j.err
#SBATCH --nodes=1
#SBATCH --ntasks=56
#SBATCH --cpus-per-task=1
#SBATCH --time=00:45:00

# Adapt these settings to your HPC system.
#SBATCH --account=<ACCOUNT>
#SBATCH --qos=<QUEUE>

set -euo pipefail

ROOT_DIR=../..
PARAMS_FILE="configs/params.txt"
EXECUTABLE="${ROOT_DIR}/build/fm.csem"

# Ensure the script is launched from the expected location.
if [[ ! -f "${ROOT_DIR}/Makefile" || ! -d configs ]]; then
    echo "ERROR: please submit this job from examples/fm"
    exit 1
fi

# Load the runtime environment.
ENV_FILE="${PETGEM_ENV:-${ROOT_DIR}/scripts/mn5/set_env.sh}"

echo
echo "Loading environment from:  ${ENV_FILE}"

source "${ENV_FILE}"

srun --cpu-bind=core "${EXECUTABLE}" -options_file "${PARAMS_FILE}"

echo
