# =============================================================================== #
# Release image: PETGEM binaries + runtime dependencies                           #
# =============================================================================== #
# BUILDER_IMAGE is the develop image (docker/dockerfile.develop); ci-release.yml
# passes the published tag with --build-arg.
ARG BUILDER_IMAGE=ghcr.io/ocastilloreyes/petgem-ci-env:latest

# ---------------------------
# Build PETGEM
# ---------------------------
FROM ${BUILDER_IMAGE} AS builder

WORKDIR /petgem
COPY Makefile ./
COPY include include
COPY src src
RUN make -j"$(nproc)" NO_COLOR=1

# ---------------------------
# Runtime
# ---------------------------
FROM ubuntu:24.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 \
        libgfortran5 \
        libgomp1 \
        libglu1-mesa \
        libxcursor1 \
        libgl1 \
        libxinerama1 \
        libxft2 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

ENV PETSC_DIR=/usr/local/petsc
ENV PETSC_ARCH=arch-linux-c-opt

COPY --from=builder ${PETSC_DIR}/${PETSC_ARCH} ${PETSC_DIR}/${PETSC_ARCH}
COPY --from=builder /usr/local/gmsh /usr/local/gmsh
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /petgem/build/fm.csem /petgem/build/im.csem /petgem/build/fm.mt /petgem/build/petgem /opt/petgem/bin/
COPY utils /opt/petgem/utils

ENV PATH="/opt/petgem/bin:/opt/venv/bin:${PETSC_DIR}/${PETSC_ARCH}/bin:/usr/local/gmsh/bin:${PATH}"

WORKDIR /workspace

CMD ["bash"]
